{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md",
        "changelogTitle": "# Changelog\n\nDerived from the commit history by semantic-release. The commits are the source;\nediting this file by hand changes the rendering and not what it renders."
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          { "path": "dist/xeno-*", "label": "Binaries, bill of materials and checksums" },
          { "path": "dist/SHA256SUMS" }
        ],
        "successComment": false,
        "failComment": false
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ]
  ]
}
